# Copy this file to `.env` and fill in values. Never commit `.env`.
# Every setting is optional: the app runs without any of them.

# --- Semantic similarity -------------------------------------------------
# Set to false to skip embeddings (e.g. on a very slow machine).
SEMANTIC_ENABLED=true
# Any sentence-transformers model name; downloaded on first use (~90 MB).
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Load the model at startup instead of on the first analysis
# (the Hugging Face Docker image sets this to true).
PRELOAD_EMBEDDING_MODEL=false

# --- Input limits --------------------------------------------------------
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=20
MIN_JOB_CHARS=30
MAX_JOB_CHARS=20000

# --- CORS (comma-separated origins allowed to call the API) --------------
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
